import streamlit as st
from sqlalchemy.orm import Session
from services.db_services.db_crud import (
    get_all_sessions,
    get_session_by_id,
    create_new_session,
)


def init_session_state():
    # Initialize Streamlit session state variables safely.
    st.session_state.setdefault("current_session_id", None)
    st.session_state.setdefault("messages", [])
    st.session_state.setdefault("all_sessions", [])


def load_sessions_into_state(db: Session):
    # Load all sessions for the sidebar.
    st.session_state.all_sessions = get_all_sessions(db)


def start_new_chat(db: Session):
    # Create a fresh chat and switch UI to it.
    new_session = create_new_session(db, title="New Chat")
    st.session_state.current_session_id = new_session.id
    st.session_state.messages = []
    return new_session


def _clear_current_chat():
    # Helper function to reset chat state
    st.session_state.messages = []
    st.session_state.current_session_id = None


def load_chat_into_state(db: Session, session_id: int):
    # Load messages from DB into Streamlit session state.
    if not session_id:
        _clear_current_chat()
        return

    session_obj = get_session_by_id(db, session_id)
    if not session_obj:
        _clear_current_chat()
        return

    st.session_state.current_session_id = session_obj.id
    st.session_state.messages = [
        {"role": msg.role, "content": msg.content} for msg in session_obj.messages
    ]
